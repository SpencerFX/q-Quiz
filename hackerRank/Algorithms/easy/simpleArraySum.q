//====================================================================
// Simple Array Sum
//
// Displays the HackerRank problem statement.
//
// Usage:
//      .quiz.hackerRank.algorithms.simpleArraySum.info[]
//====================================================================
.quiz.hackerRank.algorithms.simpleArraySum.info:{
    -1 "/Question Info ===============================================";
    -1 "/";
    -1 "Simple Array Sum";
    -1 "";
    -1 "Given an array of integers, find the sum of its elements.";
    -1 "";
    -1 "Task:";
    -1 "- Calculate the sum of all elements in the array";
    -1 "";
    -1 "Example:";
    -1 "arr = 1 2 3 4 10 11";
    -1 "";
    -1 "Result:";
    -1 "31";
    -1 "";
    -1 "Function Description:";
    -1 "simpleArraySum takes:";
    -1 "  - arr: array of integers";
    -1 "";
    -1 "Returns:";
    -1 "  - integer representing the sum of the array elements";
    -1 "";
    -1 "Input Format:";
    -1 "- First line: integer n (size of the array)";
    -1 "- Second line: n space-separated integers";
    -1 "";
    -1 "Output Format:";
    -1 "- Return a single integer representing the sum";
    -1 "";
    -1 "Constraints:";
    -1 "- 0 <= n <= 1000";
    -1 "- 0 <= arr[i] <= 1000";
    -1 "";
    -1 "Notes:";
    -1 "- A direct sum over the array is sufficient at this size";
    -1 "";
    -1 "Goal:";
    -1 "- Correctly sum the array elements";
    -1 "/";
    -1 "/=============================================================";
    -1 "";
    -1 "/ Input Info ==================================================";
    -1 "/";
    -1 "arr:1 2 3 4 10 11;";
    -1 "/";
    -1 "/=============================================================";
 };


/ Solution Info ===============================================
/ simpleArraySum arr
simpleArraySum:{[arr]
  sum arr
 };
/ =============================================================
