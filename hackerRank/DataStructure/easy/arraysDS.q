//====================================================================
// Arrays: Left Rotation (Reverse Array)
//
// Displays the HackerRank problem statement.
//
// Usage:
//      .quiz.hackerRank.dataStructures.arraysDS.info[]
//====================================================================
.quiz.hackerRank.dataStructures.arraysDS.info:{
    -1 "/Question Info ===============================================";
    -1 "/";
    -1 "Arrays: Left Rotation (Reverse Array)";
    -1 "";
    -1 "An array is a data structure that stores elements of the same";
    -1 "type in a contiguous block of memory.";
    -1 "";
    -1 "In an array of size n, each memory location has a unique index";
    -1 "(from 0 to n-1) that can be used to reference the element there.";
    -1 "";
    -1 "Task:";
    -1 "- Reverse the given array of integers";
    -1 "";
    -1 "Example:";
    -1 "arr = 2 3 4 1";
    -1 "";
    -1 "Result:";
    -1 "1 4 3 2";
    -1 "";
    -1 "Function Description:";
    -1 "arraysDS takes:";
    -1 "  - arr: array of integers";
    -1 "";
    -1 "Returns:";
    -1 "  - array of integers in reverse order";
    -1 "";
    -1 "Input Format:";
    -1 "- First line: integer n (size of the array)";
    -1 "- Second line: n space-separated integers";
    -1 "";
    -1 "Output Format:";
    -1 "- Return the array in reverse order";
    -1 "";
    -1 "Constraints:";
    -1 "- 1 <= n <= 1000";
    -1 "- -1000 <= arr[i] <= 1000";
    -1 "";
    -1 "Notes:";
    -1 "- A single pass reversal is sufficient";
    -1 "";
    -1 "Goal:";
    -1 "- Correctly reverse the array";
    -1 "/";
    -1 "/=============================================================";
    -1 "";
    -1 "/ Input Info ==================================================";
    -1 "/";
    -1 "arr:2 3 4 1;";
    -1 "/";
    -1 "/=============================================================";
 };


/ Solution Info ===============================================
/ arraysDS arr
arraysDS: {reverse x};
/ =============================================================
