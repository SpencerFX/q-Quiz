.lisp99.elementAt:{[]
    -1 "";
    -1 "======================================";
    -1 " Lisp-99 - Element At (P03)";
    -1 "======================================";
    -1 "";
    -1 "Find the K'th element of a list, where the first element is numbered 1. Gotcha: q lists are 0-indexed internally, so the 1-indexed K'th element sits at position K-1. Using input: .inputs.lisp99.easy.elementAt";
    -1 "Input: ", -3!.inputs.lisp99.easy`elementAt;
    -1 "Expected Output: ", -3!.solutions.lisp99.easy`elementAt
 };

