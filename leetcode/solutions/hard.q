//====================================================================
// leetcode — hard solutions
//
// Expected output per problem, verified by running each problem's
// own reference solution against its wired input in
// leetcode/inputs/hard.q. Single entry, so written as a plain dict
// literal - see leetcode/inputs/easy.q for why.
//
// Keyed by filename title slug, not the reference function's name -
// see leetcode/inputs/medium.q for why.
//====================================================================

.solutions.leetcode.hard:
    enlist[`medianOfTwoSortedArrays]!enlist 2f;
