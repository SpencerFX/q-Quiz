# Copy this file to .env (gitignored) and fill in real values.
# .env is loaded automatically by app.py at startup - see the
# load_dotenv() call near the top of that file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth
# client ID (type "Web application"). Not secret - it's embedded in
# /login's page source either way - but still doesn't belong hardcoded
# in source control.
GOOGLE_CLIENT_ID=
