# Copy this file to .env (gitignored) and fill in real values.
# .env is loaded automatically by app.py at startup - see the
# load_dotenv() call near the top of that file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth
# client ID (type "Web application"). Not secret - it's embedded in
# /login's page source either way - but still doesn't belong hardcoded
# in source control.
GOOGLE_CLIENT_ID=

# LinkedIn Developer Portal -> your app -> Auth tab. Unlike Google, the
# secret here IS actually used server-side (LinkedIn's OpenID Connect
# flow needs the full authorization-code exchange, not a client-side ID
# token), so both values matter and neither belongs in source control.
# The app's registered "Authorized redirect URLs" must include
# <this app's base URL>/auth/linkedin/callback exactly, e.g.
# http://127.0.0.1:8000/auth/linkedin/callback for local dev.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
