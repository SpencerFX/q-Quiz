.solutions.execution.easy: (!) . flip raze 2 cut
    (
    (`chooseDependingOnFlag;
        enlist "xyz");
    (`reverseOnCondition;
        enlist 5 4 3 2 1);
    (`conditionalChangeOfSign;
        enlist -5 -3 -20 9 10);
    (`efficientExecutionRepeatedValues;
        enlist 10 20 30 20 30 20 10);
    (`errorToStopExecution;
        enlist `$"'stop");
    (`executeRowsCharacterMatrix;
        enlist 4 9);
    (`sumNumbersCharacterMatrix;
        enlist 10)
    );

.solutions.execution.medium: (!) . flip raze 2 cut
    (
        (`a; `);
        (`b; `)
    );

.solutions.execution.hard: (!) . flip raze 2 cut
    (
        (`a; `);
        (`b; `)
    );