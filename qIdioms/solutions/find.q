.solutions.find.easy: (!) . flip raze 2 cut
    (
        (`findCharactersInString;
            enlist 6 1 4 5 4 0 8 5 1 4);
        (`findCharactersMissing;
            enlist 4 5 1 6 0 1 4 4 5 9);
        (`findRowsInList;
            enlist 2 0 2 3 1);
        (`findFlagsBoolean;
            enlist 1 3 5);
        (`findFlagsInteger;
            enlist 1 3 5);
        (`findAllOccurrencesList;
            enlist 0 2 5 7);
        (`findAllOccurrencesAtom;
            enlist 0 5);
        (`findAllOccurrencesStrings;
            enlist 0 1);
        (`firstOccurrenceCharacters;
            enlist 0 1 2 7);
        (`firstOccurrenceCharactersLong;
            enlist 0 1 2 7 1 2 1);
        (`firstOccurrenceInteger;
            enlist 2);
        (`firstOccurrenceMaximum;
            enlist 2);
        (`firstOccurrenceMinimum;
            enlist 3);
        (`firstCircularOccurrence;
            enlist 2 12 14);
        (`lastOccurrenceInteger;
            enlist 6);
        (`lastOccurrenceVector;
            enlist 6 1);
        (`lastOccurrenceFromRear;
            enlist 5 6 6 4 3 1 0 2 6 6 5 6);
        (`distinctItemsString;
            enlist "ajh");
        (`distinctItemsList;
            enlist ("banana";"pear";"apple";"cherry";"orange"));
        (`firstDifferingItem;
            enlist 4);
        (`itemsNotInList;
            enlist 2 4 6 7 8);
        (`consecutiveRepeatedItems;
            enlist 0 3 4 8 9);
        (`rowsOfMatrixInMatrix;
            enlist 0 5 8 2);
        (`itemsOfMatrixInArray;
            enlist (0 0 0 1 1 0 0 1 0 0;
                    0 1 2 1 2 1 1 2 0 1));
        (`rowsInCorrespondingRows;
            enlist (0 4 2 4;
                    4 1 4 3;
                    0 4 4 3));
        (`firstBlank;
            enlist 2);
        (`firstBlankEach;
            enlist 2 0 4);
        (`lastNonBlank;
            enlist 12);
        (`lastNonBlankEach;
            enlist 9 10 10);
        (`substringSearch;
            enlist 7 11 12 19);
        (`blankRows;
            enlist 010010b);
        (`rowsStartingWithCharacters;
            enlist ("abcd";"ijkl"))
    );

.solutions.algorithms.medium: (!) . flip raze 2 cut
    (
        (`a; `);
        (`b; `)
    );

