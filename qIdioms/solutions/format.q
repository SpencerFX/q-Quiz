.solutions.format.easy: (!) . flip raze 2 cut
    (
    (`formattedIntegers;
         ("14";"13";"09";"74";"55"));
    (`countOfFormat;
         6);
    (`leadingZerosPositiveIntegers;
         ("012";"010";"001";"026";"009";"026";"026";"037";"020";"029"));
    (`numberOfDecimals;
         4 2 0);
    (`numberOfDecimalsMaximum;
         3 2 0);
    (`positionsNonNegativeInteger;
         1 2 3 5);
    (`positionsInteger;
         4 5 1 1 8);
    (`timeFromInteger;
         "12:11:29");
    (`dateFromInteger;
         "2019/05/07");
    (`indexingPlottingCharacters;
         "distribution of primes to 1200");
    (`histogram;
         ("        *  ";"  *     *  ";"  *  *  *  ";"  ** **** *"));
    (`barChartIntegerList;
        
            ("    X  ";
             "    X  ";
             "  X X  ";
             "  X X X";
             " XX X X";
             " XXXX X";
             " XXXXXX";
             "XXXXXXX";
             "XXXXXXX"));
    (`horizontalBarChartIntegers;
        
            ("XX        ";
             "XXXXXXXX  ";
             "XXXXX     ";
             "XXXXXX    ";
             "XXX       ";
             "X         ";
             "XXXXXXX   ";
             "XXXXXXX   ";
             "XXXXXXXXXX";
             "XXXX      "));
    (`horizontalBarChartNormalized;
        
            ("X    ";
             "XXXX ";
             "XX   ";
             "XXX  ";
             "X    ";
             "     ";
             "XXX  ";
             "XXX  ";
             "XXXXX";
             "XX   "))
    );

.solutions.format.medium: (!) . flip raze 2 cut
    (
    (`a; `);
    (`b; `)
    );

