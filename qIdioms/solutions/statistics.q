    (`movingSum;1 3 6 10 15 23);
    (`movingMaximum;1 2 3 5 7 11);
    (`movingMinimum;1 1 1 2 3 5);
    (`movingMaximumIndex;0 1 2 3 4 5);
    (`movingMinimumIndex;0 0 0 1 2 3)
    );

