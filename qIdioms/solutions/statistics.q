.solutions.statistics.easy: (!) . flip raze 2 cut
    (
    (`maximum;enlist 5 3 7 2);
    (`nonNegativeMaximum;enlist -1 -2 -3 -4 -5);
    (`maximumWeighted;((1 2 3 4 5);5 4 3 2 1));
    (`minimum;enlist 5 3 7 2);
    (`minimumWeighted;((1 2 3 4 5);5 4 3 2 1));
    (`average;enlist 1 10 100);
    (`weightedAverage;((78 80 90 88 72);20 15 20 22 19));
    (`median;enlist 61 20 51 12 31 51 29 35 17 89);
    (`standardDeviation;enlist 44 77 48 24 28 36 17 49 90 91);
    (`variance;enlist 44 77 48 24 28 36 17 49 90 91f);
    (`runningSum;enlist 1 20 300 4000);
    (`movingSum;((1 2 3 5 7 11);3));
    (`movingMaximum;((1 2 3 5 7 11);3));
    (`movingMinimum;((1 2 3 5 7 11);3));
    (`movingMaximumIndex;((1 2 3 5 7 11);3));
    (`movingMinimumIndex;((1 2 3 5 7 11);3))
    );

.solutions.statistics.medium: (!) . flip raze 2 cut
    (
    (`a;`);
    (`b;`)
    );

